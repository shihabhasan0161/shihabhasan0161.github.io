---
import ExperienceList from "@/components/ExperienceList.astro";
import Link from "@/components/Link.astro";
import PostsList from "@/components/PostsList.astro";
import ProjectsList from "@/components/ProjectsList.astro";
import Layout from "@/layouts/Layout.astro";
import links from "@/lib/links";
---

<Layout title="Hello, I'm Shihab 👋🏻">
  <div
    class="prose prose-zinc dark:prose-invert prose-strong:text-zinc-900 dark:prose-strong:text-zinc-100 prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline mt-6 space-y-5"
  >
    <p>
      A Computer Science student at York University, currently seeking Summer 2026 internship
      opportunities. I&apos;m passionate about building data-driven and scalable software, learning
      new technologies, and delivering impactful solutions. Experienced as a Backend Developer
      Intern and AI/ML Engineer, I enjoy solving complex problems, collaborating across teams, and
      contributing to open-source projects.
    </p>

    <p>
      Feel free to explore my projects below or connect with me on GitHub and LinkedIn. I’m always
      open to discussing new ideas, collaboration, or internship opportunities.
    </p>

    <div class="flex items-center gap-4">
      {
        links
          .filter((link) => !link.disabled)
          .map((link) => (
            <Link
              href={link.href}
              class="ease-outhover:-translate-y-1 inline-block rounded-md p-2 ring ring-zinc-300 transition-all duration-300 hover:scale-110 hover:ring-zinc-500 dark:ring-zinc-700 dark:hover:ring-zinc-400"
              external
            >
              <div class="sr-only">{link.name}</div>
              <link.icon />
            </Link>
          ))
      }
    </div>
  </div>

  <ProjectsList limit={5} displaySectionTitle displaySeeAllLink />
  <ExperienceList />
  <PostsList displaySectionTitle displaySeeAllLink />
</Layout>
