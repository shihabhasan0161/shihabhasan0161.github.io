---
import Link from "@/components/Link.astro";
import PostsList from "@/components/PostsList.astro";
import ProjectsList from "@/components/ProjectsList.astro";
import Layout from "@/layouts/Layout.astro";
import links from "@/lib/links";
---

<Layout title="Hello, I'm Shihab 👋🏻">
  <div
    class="prose prose-zinc prose-strong:text-stone-400 prose-strong:font-medium prose-a:text-stone-400 prose-a:hover:text-stone-400/70 prose-a:transition-colors mt-6 space-y-5 text-zinc-300"
  >
    <p>
      I'm a computer science student in my 2nd year at the York University, Canada. I have a strong passion for AI and Software Development with a focus on full stack development. I have an experience as a Backend Developer Intern at Vosyn Inc. where I worked on contributing to the development of the backend systems using Python, Django, and SQL. Currently, I'm looking for an internship opportunity for Summer 2026.
    </p>

    <p>
      Outside of my educational and professional role, I enjoy exploring new programming languages, tools, and
      emerging tech. Take a look at my <Link href="/projects">projects</Link> and contributions on <Link
        href="https://github.com/shihabhasan0161"
        external>GitHub</Link
      >.
    </p>
    <p>
      Aside from my passion for web and software development, I go to the gym regularly, read books, and play video games. I also enjoy taking long walks and exploring nature.
    </p>

    <div class="flex items-center gap-4">
      {
        links
          .filter((link) => !link.disabled)
          .map((link) => (
            <Link href={link.href} class="inline-block rounded-md p-2 ring ring-stone-700" external>
              <div class="sr-only">{link.name}</div>
              <link.icon />
            </Link>
          ))
      }
    </div>
  </div>

  <ProjectsList limit={3} displaySectionTitle displaySeeAllLink />
  <PostsList displaySectionTitle displaySeeAllLink />
</Layout>
