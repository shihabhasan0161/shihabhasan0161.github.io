---
import projects from "@/lib/projects";

interface Props {
  limit?: number;
  displaySectionTitle?: boolean;
  displaySeeAllLink?: boolean;
}

const { limit = 0, displaySeeAllLink = false, displaySectionTitle = false } = Astro.props;
---

<section class="text-zinc-900 dark:text-zinc-300">
  <div class="flex items-center justify-between">
    {displaySectionTitle && <h2 class="text-lg font-medium">Projects</h2>}
    {
      displaySeeAllLink && (
        <a
          class="text-sm text-zinc-900 underline transition-colors hover:text-indigo-600 dark:text-zinc-300 dark:hover:text-indigo-400"
          href="/projects"
        >
          See all projects
        </a>
      )
    }
  </div>

  <ul class="mt-4 [&>li:first-child_div]:rounded-t-lg [&>li:last-child_div]:rounded-b-lg">
    {
      projects.slice(0, limit || undefined).map((project) => (
        <li class="group relative">
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="block border-b border-zinc-200 py-4 pr-8 dark:border-zinc-800"
          >
            <h3 class="font-medium text-zinc-900 transition-colors duration-300 ease-in-out group-hover:text-indigo-700 dark:text-zinc-100 dark:group-hover:text-white">
              {project.name}
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-zinc-600 transition-colors duration-300 ease-in-out group-hover:text-zinc-800 dark:text-zinc-400 dark:group-hover:text-zinc-300">
              {project.description}
            </p>

            <div class="mt-2.5 flex flex-wrap gap-2.5 text-xs tracking-wide text-zinc-600 dark:text-zinc-400">
              {project.tech.map((tech) => (
                <span class="rounded-sm bg-zinc-100 px-1.5 py-1 transition-colors duration-300 ease-in-out group-hover:bg-zinc-200 dark:bg-zinc-700/60 dark:group-hover:bg-zinc-600">
                  {tech}
                </span>
              ))}
            </div>
          </a>

          <div class="absolute inset-0 -inset-x-4 -top-[1px] -z-10 bg-transparent transition-colors duration-300 ease-in-out group-hover:bg-zinc-50 dark:group-hover:bg-zinc-800" />

          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="absolute top-1/2 -right-1 hidden size-5 -translate-y-1/2 -rotate-45 fill-none stroke-current stroke-[2px]"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="absolute top-1/2 -right-1 size-5 -translate-y-1/2 -rotate-45 fill-none stroke-current stroke-[2px] text-zinc-400 opacity-60 transition-all duration-300 ease-in-out group-hover:text-zinc-700 group-hover:opacity-100 dark:text-zinc-500 dark:group-hover:text-white"
          >
            <line
              x1="5"
              y1="12"
              x2="19"
              y2="12"
              class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100"
            />
            <polyline
              points="12 5 19 12 12 19"
              class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0"
            />
          </svg>
        </li>
      ))
    }
  </ul>
</section>
