---
import headerIcon from "@/assets/header-icon.png";
import { Image } from "astro:assets";
import ThemeIcon from "./ThemeIcon.astro";

const navigationLinks = [
  { text: "home", href: "/" },
  { text: "projects", href: "/projects" },
  { text: "blog", href: "/blog" },
];
---

<header class="flex items-center justify-between py-5 text-zinc-900 dark:text-zinc-300">
  <div>
    <a href="/">
      <Image
        src={headerIcon}
        alt="icon"
        width={30}
        height={30}
        format="avif"
        layout="fixed"
        priority
      />
    </a>
  </div>
  <nav class="flex items-center gap-2">
    {
      navigationLinks.map((link, idx) => (
        <>
          {/* prettier-ignore */}
          <a class="underline decoration-zinc-500/50 dark:decoration-zinc-300/50 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" href={link.href}>{link.text}</a>
          {idx !== navigationLinks.length - 1 && <span> / </span>}
        </>
      ))
    }
    <ThemeIcon />
  </nav>
</header>
